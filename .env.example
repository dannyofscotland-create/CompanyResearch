# Optional: used to turn the briefing into prose. The app still works without this.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Used when OPENAI_API_KEY is empty. Install a local model, e.g. `ollama pull llama3.1`
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# SEC requires a descriptive User-Agent. Put a real contact email if you use this a lot.
SEC_USER_AGENT=CompanyResearch/0.1 (local research tool; you@example.com)

# Leave true unless your PC's HTTPS inspection breaks Python SSL (common on Windows).
SSL_VERIFY=true

# Where the pretend wallet and cache live. On a VPS use /data.
# COMPANYRESEARCH_DATA=.cache

# Required when the app is on the public internet (phone access). Pick a private phrase.
# ACCESS_CODE=change-me
